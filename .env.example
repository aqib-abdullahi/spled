# Copy to .env and fill in. Never commit .env.
DEBUG=True
SECRET_KEY=
DATABASE_URL=postgis://USER:PASSWORD@localhost:5432/spled
ALLOWED_HOSTS=
CSRF_TRUSTED_ORIGINS=

# Production only:
# SECURE_SSL_REDIRECT=True
# HSTS_SECONDS=3600
# BEHIND_PROXY=False
# TRUSTED_PROXY_COUNT=1
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=True
# DEFAULT_FROM_EMAIL=Spled <no-reply@example.com>

# Map tiles (optional; OpenStreetMap is used if these are unset, for development only).
# MAP_TILE_URL=https://tiles.example.com/{z}/{x}/{y}.png
# MAP_TILE_ATTRIBUTION=© <a href="https://example.com/credit">Provider</a> © <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors
# MAP_TILE_MAX_ZOOM=19
# MAP_TILE_SIZE=256

# Public contact address shown on the Contact page (optional).
# CONTACT_EMAIL=

# Photo storage. "local" (default) keeps photos on disk; "r2" uses a private Cloudflare R2 bucket.
# PHOTO_STORAGE=local
# R2_ENDPOINT_URL=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_PHOTO_BUCKET=

# Backups (optional)
# BACKUP_DIR=
# PG_BIN_DIR=

# Set only if photos stay on a local disk that survives restarts and redeploys.
# PHOTOS_ON_PERSISTENT_DISK=False

# Off-site backups (optional). R2_ENDPOINT_URL is shared with photo storage.
# BACKUP_ENCRYPTION_KEY=
# R2_BACKUP_BUCKET=
# R2_BACKUP_ACCESS_KEY_ID=
# R2_BACKUP_SECRET_ACCESS_KEY=

# Container hosting (optional)
# WEB_CONCURRENCY=2
# GUNICORN_TIMEOUT=60
# GDAL_LIBRARY_PATH=
# GEOS_LIBRARY_PATH=

# First admin account, created once at startup if it does not exist (optional).
# Make the hash with: python manage.py hash_password
# ADMIN_EMAIL=
# ADMIN_NAME=
# ADMIN_PASSWORD_HASH=
